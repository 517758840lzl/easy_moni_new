<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />

    <item>
        <bitmap
            android:gravity="fill"
            android:src="@drawable/splash_login_bg" />
    </item>

    <item android:bottom="68dp">
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_launch_icon" />
    </item>

    <item android:bottom="74dp">
        <bitmap
            android:gravity="bottom|center_horizontal"
            android:src="@drawable/splash_launch_brand" />
    </item>

    <item android:bottom="44dp">
        <bitmap
            android:gravity="bottom|center_horizontal"
            android:src="@drawable/splash_bottom_text" />
    </item>
</layer-list>
