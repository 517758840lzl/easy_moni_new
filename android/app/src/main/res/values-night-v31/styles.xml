<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 及以上夜间模式启动页配置，和普通模式保持品牌一致。 -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_launch_icon</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/splash_launch_footer</item>
        <item name="android:navigationBarColor">@color/splash_navigation_bar</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
