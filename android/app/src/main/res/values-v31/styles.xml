<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 及以上系统启动页配置，受系统 SplashScreen 能力限制。 -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_launch_icon</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/splash_launch_footer</item>
        <item name="android:navigationBarColor">@color/splash_navigation_bar</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
