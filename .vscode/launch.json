{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "easy_moni",
            "request": "launch",
            "type": "dart",
            "cwd": "${workspaceFolder}",
            "program": "lib/main.dart",
            "toolArgs": [
                "--dart-define=APP_ENV=production"
            ]
        },
        {
            "name": "easy_moni production",
            "request": "launch",
            "type": "dart",
            "cwd": "${workspaceFolder}",
            "program": "lib/main.dart",
            "toolArgs": [
                "--dart-define=APP_ENV=production"
            ]
        },
        {
            "name": "easy_moni22",
            "request": "launch",
            "type": "dart",
            "cwd": "${workspaceFolder}",
            "program": "lib/main.dart",
            "toolArgs": [
                "--dart-define=APP_ENV=production"
            ],
            "deviceId": "emulator-5554"
        },
        {
            "name": "easy_moni (profile mode)",
            "request": "launch",
            "type": "dart",
            "cwd": "${workspaceFolder}",
            "program": "lib/main.dart",
            "flutterMode": "profile"
        },
        {
            "name": "easy_moni (release mode)",
            "request": "launch",
            "type": "dart",
            "cwd": "${workspaceFolder}",
            "program": "lib/main.dart",
            "flutterMode": "release"
        }
    ]
}
