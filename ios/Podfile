platform :ios, '14.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

# AppsFlyer Strict：使用 NSPrivacyTracking=false 的 Privacy Manifest，
# 与 Runner「不追踪」声明对齐。官方 Flutter 插件默认依赖 Main（nonStrict）。
# 见：appsflyer_sdk doc/Installation.md → Strict mode
def ensure_appsflyer_strict_podspec!
  candidates = [
    File.join(__dir__, '.symlinks', 'plugins', 'appsflyer_sdk', 'ios', 'appsflyer_sdk.podspec'),
    File.join(Dir.home, '.pub-cache', 'hosted', 'pub.flutter-io.cn', 'appsflyer_sdk-6.17.8', 'ios', 'appsflyer_sdk.podspec'),
    File.join(Dir.home, '.pub-cache', 'hosted', 'pub.dev', 'appsflyer_sdk-6.17.8', 'ios', 'appsflyer_sdk.podspec'),
  ]
  path = candidates.find { |p| File.exist?(p) }
  raise 'appsflyer_sdk.podspec not found; run flutter pub get first' if path.nil?

  contents = File.read(path)
  return if contents.include?("AppsFlyerFramework/Strict")

  updated = contents.gsub(
    /ss\.ios\.dependency ['"]AppsFlyerFramework['"],\s*['"]([^'"]+)['"]/,
    "ss.ios.dependency 'AppsFlyerFramework/Strict', '\\1'"
  )
  if updated == contents
    raise "Failed to switch AppsFlyerFramework to Strict in #{path}"
  end
  File.write(path, updated)
  Pod::UI.puts "Patched AppsFlyer → Strict: #{path}"
end

ensure_appsflyer_strict_podspec!

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '14.0'
    end
  end
end
